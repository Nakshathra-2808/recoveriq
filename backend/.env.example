# ==============================================================================
# RecoverIQ Backend Environment Configuration (Example)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Environment & Server
ENVIRONMENT=development
PROJECT_NAME="RecoverIQ Backend"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# Razorpay Test Configuration (Stage 5 Sandbox Integration)
# Use your Razorpay Test Key ID & Key Secret from Dashboard -> Settings -> API Keys
# Environment is strictly TEST. Live/production keys are forbidden in demo/test modes.
RAZORPAY_ENVIRONMENT=test
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=5.0

# LLM AI Diagnosis Layer (Stage 4)
# Supported providers: gemini, openai, groq, mock
# If left blank, RecoverIQ automatically operates with deterministic fallback (offline-safe)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=5.0
