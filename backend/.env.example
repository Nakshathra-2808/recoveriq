# Environment
ENVIRONMENT=development
PROJECT_NAME="RecoverIQ Backend"
API_V1_STR=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth & JWT Configuration (Fill when connecting Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-jwt-secret-placeholder

# Razorpay Sandbox / Test Keys (Fill when connecting Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
